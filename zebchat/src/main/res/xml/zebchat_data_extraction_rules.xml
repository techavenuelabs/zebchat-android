<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and device-transfer rules (Android 12+) that keep the ZebChat visitor session out of
  backups. Use as android:dataExtractionRules="@xml/zebchat_data_extraction_rules" when your app
  has no rules of its own; otherwise copy the exclude lines into yours. See README.md, "Backups".
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="com.zebchat.chat.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="com.zebchat.chat.xml" />
    </device-transfer>
</data-extraction-rules>
